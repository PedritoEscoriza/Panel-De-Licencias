# ─────────────────────────────────────────────────────────────
# BOT DE TRADING — Binance
# ─────────────────────────────────────────────────────────────

# Modo de operación:
#   simulado = precios REALES de Binance, órdenes FALSAS (plata ficticia). SIN keys.
#   testnet  = Binance Testnet: órdenes reales con plata de mentira. Necesita keys.
#   real     = Binance real: PLATA DE VERDAD.
BOT_MODO=simulado

# Puerto del panel (8000 funciona en todos los navegadores)
BOT_PUERTO=8000

# ── Para pasar a TESTNET (plata de mentira, pero órdenes reales) ──
# 1) Creá tus keys GRATIS en: https://testnet.binance.vision
#    (Log in with GitHub → "Generate HMAC_SHA256 Key")
# 2) Pegalas acá abajo, SIN el # adelante:
# 3) Y arriba cambiá  BOT_MODO=simulado  por  BOT_MODO=testnet
#
# BINANCE_TESTNET_API_KEY=pega_tu_api_key_de_testnet
# BINANCE_TESTNET_API_SECRET=pega_tu_secret_de_testnet

# ── Para operar REAL (plata de verdad — activar solo cuando estés seguro) ──
# BINANCE_API_KEY=pega_tu_api_key_real
# BINANCE_API_SECRET=pega_tu_secret_real
