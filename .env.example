# ─────────────────────────────────────────────────────────────
# BOT DE TRADING — variables opcionales
# Copiá lo que necesites a tu archivo .env
# ─────────────────────────────────────────────────────────────

# Modo de operación:
#   simulado = precios reales, órdenes falsas (NO necesita keys). Por defecto.
#   testnet  = Binance Testnet (plata de mentira, necesita keys de testnet)
#   real     = Binance real (PLATA DE VERDAD)
BOT_MODO=simulado

# Par y estrategia (el bot funciona sin tocar nada de esto)
BOT_SYMBOL=BTC/USDT
BOT_TIMEFRAME=5m
BOT_INTERVALO=15          # segundos entre cada análisis
BOT_CAPITAL=1000          # capital simulado inicial (USDT)
BOT_RIESGO_PCT=20         # % del capital por operación
BOT_TAKE_PROFIT=0.8       # % de ganancia objetivo por trade
BOT_STOP_LOSS=1.0         # % de pérdida máxima por trade
BOT_COMISION=0.1          # % de comisión por operación
BOT_NOTICIAS_CADA=300     # cada cuántos segundos refrescar las noticias
BOT_PUERTO=5060

# Resumen del mercado por WhatsApp (reusa el Twilio que ya tenés arriba)
# BOT_WHATSAPP_TO=+5491122334455   # tu número; también podés ponerlo en el panel

# ── Solo para modo testnet ──
# Crealas gratis en https://testnet.binance.vision
# BINANCE_TESTNET_API_KEY=
# BINANCE_TESTNET_API_SECRET=

# ── Solo para modo real (¡cuidado!) ──
# BINANCE_API_KEY=
# BINANCE_API_SECRET=
